# Gift data for the /gift page.
#
# Single-line JSON only. One object per child: a first name, and that child's
# NJBEST Ugift code. The order here is the order they render on the page.
#
# The authoritative copy lives in the password manager. Both the GitHub Actions
# secret GIFT_DATA and your local .env.local are derived from it -- Actions
# secrets are write-only and cannot be read back.
#
# Copy this file to .env.local and replace the values. Never commit real data.
GIFT_DATA=[{"name":"Example","code":"AAA-000"},{"name":"Sample","code":"BBB-111"}]
