---
import { GIFT_DATA } from 'astro:env/server';
import Base from '../layouts/Base.astro';
import { readGiftData } from '../lib/gift';

// Throws at build time on missing or malformed data, so this page can never
// ship with blank or duplicated codes. See src/lib/gift.ts.
const children = readGiftData(GIFT_DATA);

// Not yet confirmed against NJBEST. Deliberately rendered as visible gaps
// rather than plausible-sounding guesses -- do not publish until both are
// replaced with observed values.
const MINIMUM = '[CONFIRM: NJBEST minimum contribution]';
const PAYMENT_METHODS = '[CONFIRM: which online payment methods NJBEST offers]';

const UGIFT_URL = 'https://www.ugift529.com';
---

<Base
	title="Gift a 529 contribution — William Zelesny"
	description="How to contribute to a NJBEST 529 college savings plan."
	unlisted
>
	<main class="mx-auto max-w-xl px-6 py-16 sm:py-24">
		<nav class="text-sm">
			<a
				href="/"
				class="inline-flex items-center gap-2 text-neutral-500 transition hover:text-neutral-900"
			>
				<span aria-hidden="true">←</span>
				William Zelesny
			</a>
		</nav>

		<h1 class="mt-8 text-3xl font-semibold tracking-tight sm:text-4xl">
			Contributing to the kids' 529 plans
		</h1>

		<p class="mt-4 text-neutral-700 leading-relaxed">
			This page is mine — William Zelesny. If you were sent here and want to check
			it is genuine before going further, the link above goes to the rest of my
			site, and you can reach me at
			<a
				href="mailto:william@zelesny.com"
				class="underline decoration-neutral-300 underline-offset-4 transition hover:decoration-neutral-900"
				>william@zelesny.com</a
			>.
		</p>

		<section class="mt-12">
			<h2 class="text-sm font-medium uppercase tracking-wider text-neutral-500">
				The codes
			</h2>
			<ul class="mt-4 space-y-3">
				{
					children.map(({ name, code }) => (
						<li class="rounded-lg border border-neutral-200 px-5 py-4">
							<div class="text-sm text-neutral-500">{name}</div>
							<code
								class="mt-1 block select-all font-mono text-xl tracking-[0.18em] text-neutral-900"
								>{code}</code
							>
						</li>
					))
				}
			</ul>
			<p class="mt-3 text-sm text-neutral-500">
				Tap a code to select the whole thing.
			</p>
		</section>

		<section class="mt-12 space-y-4 text-neutral-700 leading-relaxed">
			<h2 class="text-sm font-medium uppercase tracking-wider text-neutral-500">
				What the code is
			</h2>
			<p>
				Each child has a 529 college savings account with NJBEST. A Ugift code is
				the way to put money into one without needing the account number.
			</p>
			<p>
				A code can only add money. It does not show the balance, it cannot be used
				to take anything out, and it gives no access to the account itself. If a
				code ends up somewhere it shouldn't, the worst that happens is a stranger
				contributes.
			</p>
		</section>

		<section class="mt-12">
			<h2 class="text-sm font-medium uppercase tracking-wider text-neutral-500">
				How to give
			</h2>
			<ol class="mt-4 space-y-4 text-neutral-700 leading-relaxed">
				<li>
					<span class="font-medium text-neutral-900">1.</span> Go to
					<a
						href={UGIFT_URL}
						target="_blank"
						rel="noopener noreferrer"
						class="underline decoration-neutral-300 underline-offset-4 transition hover:decoration-neutral-900"
						>ugift529.com</a
					>. It opens in a new tab, so this page stays open behind it with the
					code still on screen.
				</li>
				<li>
					<span class="font-medium text-neutral-900">2.</span> Enter the code for
					the child you're giving to.
				</li>
				<li>
					<span class="font-medium text-neutral-900">3.</span> Choose an amount.
					The minimum is {MINIMUM}.
				</li>
				<li>
					<span class="font-medium text-neutral-900">4.</span> Pay by
					{PAYMENT_METHODS}, or mail a check instead if you'd rather not enter
					bank details online.
				</li>
				<li>
					<span class="font-medium text-neutral-900">5.</span> You'll get a
					confirmation page and an email. Your name shows up next to the gift on
					our end, so we'll know it was you.
				</li>
			</ol>
		</section>

		<p class="mt-12">
			<a
				href={UGIFT_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-baseline gap-2 text-neutral-900 underline decoration-neutral-300 underline-offset-4 transition hover:decoration-neutral-900"
			>
				Go to Ugift
				<span aria-hidden="true" class="text-neutral-400">→</span>
			</a>
		</p>

		<p class="mt-12 text-sm text-neutral-500">
			Any trouble, or you'd rather just hand over a check — email me and I'll sort
			it out.
		</p>
	</main>
</Base>
